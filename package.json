{
  "name": "repodock",
  "private": true,
  "version": "0.1.0",
  "description": "RepoDock: widget de escritorio para listar tus repositorios y abrirlos en VS Code o Cursor con un click.",
  "author": "Kevin Marquez",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "tsc -b && vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/copy-electron-assets.cjs",
    "build": "npm run build:renderer && npm run build:electron",
    "electron:dev": "concurrently -k -n VITE,ELECTRON -c blue,green \"npm:dev\" \"npm run build:electron && wait-on tcp:5173 && cross-env NODE_ENV=development electron dist-electron/main.js\"",
    "electron:package:win": "npm run build && electron-builder --win --publish never",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "41.0.0",
    "electron-builder": "^26.15.3",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "vite": "^5.4.21",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "@electron/get": "^3.0.0"
  },
  "build": {
    "appId": "cl.kevinmarquez.repodock",
    "productName": "RepoDock",
    "icon": "build/icon.ico",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
